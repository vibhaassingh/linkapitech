# Analytics (env-driven only — never hardcode a measurement ID). Leave blank to disable.
NEXT_PUBLIC_ANALYTICS_ID=

# Public site origin, used for absolute OG/canonical URLs and sitemap.
NEXT_PUBLIC_SITE_URL=https://linkapitech.com

# Contact form delivery (server-side). Wire one real handler before launch.
# Example: a Resend API key + destination inbox. Left blank => the API route
# logs the submission and returns success (dev-safe, no external calls).
CONTACT_TO_EMAIL=partnership@linkapitech.com
RESEND_API_KEY=

# ── The Bank Plugin landing sites (optional) ─────────────────────────────────
# Each of the three bank landing pages can answer on its own subdomain; set a
# host here and middleware.ts serves that bank's page at the subdomain root,
# with its canonical URL and cross-links following automatically.
#
# LEAVE BLANK and the pages stay on the main domain at /bank-plugin/<slug>,
# which is what local dev and Vercel previews use.
#
# DO NOT set these to axis/hsbc/indusind.linkapitech.com — those names already
# serve the client's live plugin PORTAL apps (register, OTP, login, download).
# Add whichever names the client confirms, then add them as domains in Vercel.
NEXT_PUBLIC_PLUGIN_HOST_AXIS=
NEXT_PUBLIC_PLUGIN_HOST_HSBC=
NEXT_PUBLIC_PLUGIN_HOST_INDUSIND=
